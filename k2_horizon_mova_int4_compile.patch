+def _k2_horizon_mova_int4(
+    hidden_states: torch.Tensor,
+    qweight: torch.Tensor,
+    scale: torch.Tensor,
+    zp: torch.Tensor | None,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    group_size: int,
+    num_experts: int,
+    hidden_size: int,
+) -> torch.Tensor:
+    """Quantized MoVA value projection, run OUTSIDE the compiled graph.
+
+    The int4 tile config must be chosen from the real token count per call
+    (the wna16 CUDA/Triton split and the CUDA kernel's BLOCK_SIZE_M <= 64 cap
+    both depend on M). try_get_optimal_moe_config reads JSON config files and
+    queries NVML, which Dynamo cannot trace under vLLM's fullgraph compile
+    ("Dynamo does not know how to trace method `__call__` of class
+    `_FuncPtr`"), so the whole thing is an opaque custom op.
+    """
+    _, N, _ = qweight.shape
+    w1_shape = torch.Size([num_experts, N, hidden_size])
+    block_shape = [0, group_size]
+    config = try_get_optimal_moe_config(
+        w1_shape=w1_shape,
+        w2_shape=torch.Size([num_experts, hidden_size, N]),
+        top_k=topk_ids.size(1),
+        dtype=_get_config_dtype_str(
+            use_fp8_w8a8=False,
+            use_int8_w8a16=False,
+            use_int4_w4a16=True,
+            dtype=hidden_states.dtype,
+        ),
+        M=hidden_states.size(0),
+        block_shape=block_shape,
+    )
+    return fused_mova_impl(
+        config=config,
+        hidden_states=hidden_states.contiguous(),
+        w1=qweight,
+        topk_weights=topk_weights.contiguous(),
+        topk_ids=topk_ids.contiguous(),
+        use_int4_w4a16=True,
+        w1_scale=scale,
+        w1_zp=zp,
+        block_shape=block_shape,
+        global_num_experts=num_experts,
+        expert_map=None,
+    )
+
+
+def _k2_horizon_mova_int4_fake(
+    hidden_states: torch.Tensor,
+    qweight: torch.Tensor,
+    scale: torch.Tensor,
+    zp: torch.Tensor | None,
+    topk_weights: torch.Tensor,
+    topk_ids: torch.Tensor,
+    group_size: int,
+    num_experts: int,
+    hidden_size: int,
+) -> torch.Tensor:
+    return hidden_states.new_empty((hidden_states.size(0), qweight.size(1)))
+
+
+direct_register_custom_op(
+    op_name="k2_horizon_mova_int4",
+    op_func=_k2_horizon_mova_int4,
+    fake_impl=_k2_horizon_mova_int4_fake,
+)
+
